; AXY Test Program - Tests all compiler features
; Run: ./axy test-program.axy test-program.asm

; ============================================
; Program start (via an implicit constant chain)
; ============================================

	start_addr = &1900
	alt_start_addr = &1a00

	variables = &100

	org start_addr

; ============================================
; Variable declarations
; ============================================

	axyvar variables

	var lives
	var score
	var counter
	var temp
	var v1
	var v2

; ============================================
; Constants
; ============================================

; Every constant is emitted as a BeebAsm symbol and referenced by name.

	limit = 100			; number constant
	maximum = limit			; constant chain - referenced as #maximum, not #limit
	lives_limit = 5			; implicit number constant (no 'const' keyword)
	max_value = 99
	target = 10
	zero = 0
	space = ' '			; character constant (ASCII value)

					; unused string constant in this source file but defined in beebasm for others to use
	welcomeMessage = "Welcome to axy compiler"
	dummy = welcomeMessage


; ============================================
; Test 1: Basic assignment (number constants)
; ============================================

.start
	lives = lives_limit		; LDA #lives_limit / STA lives
	score = zero			; LDA #zero / STA score
	counter = target		; LDA #target / STA counter
	temp = max_value		; LDA #max_value / STA temp

	jmp test2

; ============================================
; Test 2: Constants referenced by name
; ============================================

	ORG alt_start_addr		; test uppercase keyword
	
.test2

	a = maximum			; chain by name -> LDA #maximum
	x = space			; character    -> LDX #space
	temp = maximum			; chain by name -> LDA #maximum / STA temp

; ============================================
; Test 3: Register operations
; ============================================

	a = 42				; LDA #42
	x = lives			; LDX lives
	lives = x			; STX lives
	y = counter			; LDY counter
	counter = y			; STY counter

; ============================================
; Test 4: Register transfers
; ============================================

	a = x				; TXA
	x = a				; TAX
	a = y				; TYA
	y = a				; TAY

; ============================================
; Test 5: Increment/Decrement
; ============================================

	x += 1				; INX
	x -= 1				; DEX
	y += 1				; INY
	y -= 1				; DEY

	lives += 1			; INC lives
	score -= 1			; DEC score
	counter += 1			; INC counter

; ============================================
; Test 6: Labels and unconditional jumps
; ============================================

.test6

	temp += 1
	jmp start

; ============================================
; Test 7: If statements
; ============================================

.check_lives

	if lives == lives_limit
	score = 100
	endif

	if lives != 5
	score = 0
	endif

	if a == space			; CMP #space
	score = 1
	endif

	if maximum == limit		; compare two constants !
	score = 0
	endif

; ============================================
; Test 8: While loop
; ============================================

	counter = 10
	while counter != 0
	score += 1
	counter -= 1
	endwhile

; ============================================
; Test 9: Nested control flow
; ============================================

	counter = 5

.outer

	if counter == 0
	jmp done
	endif

	temp = 3

.inner

	if temp == 0
	jmp next
	endif

	score += 1
	temp -= 1
	jmp inner

.next

	counter -= 1
	jmp outer

; ============================================
; Test 10: Assembler mode (asm / endasm)
; ============================================

; Raw BeebAsm passes through verbatim. AXY variables and constants are known
; inside an asm block, and a constant defined there is usable from AXY.

	asm

	secret = &47			; constant defined in raw asm

	ldx #0
.loop_a

	txa
	sta lives,X			; AXY variable
	inx
	cpx #limit			; AXY constant
	bne loop_a

	lda #&A5			; BeebAsm-only notation, never parsed by AXY
	sta temp

	endasm

	a = secret			; LDA #secret (defined in AXY)

; ============================================
; Test 11: Repeat / until loop
; ============================================

; The body always runs at least once; until tests after the body and loops
; back while the condition is false.

	counter = 3

	repeat
	counter -= 1
	until counter == 0

	counter = 3

	repeat
	counter -= 1
	until counter != 2

; ============================================
; Final - all tests passed
; ============================================

.done

	a = 42	  			; Success marker

; ============================================
; Test extended += / -=
; ============================================

					; Extended += with number literal
	v1 += 5				; should generate: lda v1 / clc / adc #5 / sta v1

					; Extended -= with variable
	v1 -= v2			; should generate: lda v1 / sec / sbc v2 / sta v1

					; Extended += with constant
	v1 += C5			; should generate: lda v1 / clc / adc #C5 / sta v1

					; Register a extended operations
	a += 10				; should generate: clc / adc #10
	a -= v1				; should generate: sec / sbc v1

					; Register x extended operations (via accumulator)
	x += v2				; should generate: txa / clc / adc v2 / tax
	y -= 2				; should generate: tya / sec / sbc #2 / tay

					; Optimization preserved: += 1 / -= 1 on variables
	v1 += 1				; should generate: inc v1
	v1 -= 1				; should generate: dec v1

					; Optimization preserved: += 1 / -= 1 on x/y
	x += 1				; should generate: inx
	y -= 1				; should generate: dey

					; Carry flag note: always clc/sec precedes adc/sbc
					; Users must manage carry state in complex sequences
