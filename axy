#!/usr/bin/env python3
"""
AXY Compiler - Translates .axy files to BeebAsm 6502 assembly
Named after the 6502 registers: A, X, Y
"""

import datetime
import os
import sys

def timestamp():
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M")

def parse_number(text):
    if text.startswith('&'):
        return int(text[1:], 16)
    if text.startswith('%'):
        return int(text[1:], 2)
    return int(text, 10)

KEYWORDS = ('axyvar', 'var', 'org',
            'if', 'endif', 'while', 'endwhile', 'repeat', 'until',
            'jmp', 'jsr', 'rts', 'pha', 'pla',
            'asm', 'endasm')

SYMBOLS_FILE = '.axysymbols'

class AXYCompiler:
    def __init__(self):
        self.symbols = {}
        self.next_var = None
        self.output = []
        self.errors = []
        self.current_raw = None
        self.label_counter = 0
        self.const_def_lines = set()
        
        # Pre-declare registers
        self.symbols['a'] = {'type': 'reg', 'name': 'A'}
        self.symbols['x'] = {'type': 'reg', 'name': 'X'}
        self.symbols['y'] = {'type': 'reg', 'name': 'Y'}

    def tokenize(self, line):
        if ';' in line:
            line = line[:line.index(';')]
        line = line.strip()
        if not line:
            return [], []
        
        tokens = []
        cols = []
        current = ""
        start_col = 0
        i = 0
        while i < len(line):
            c = line[i]
            if c.isspace():
                if current:
                    tokens.append(current)
                    cols.append(start_col)
                    current = ""
                i += 1
            elif c in '+-*/=<>!':
                op = c
                op_col = i
                i += 1
                if i < len(line) and line[i] in '+=-><=!':
                    op += line[i]
                    i += 1
                if current:
                    tokens.append(current)
                    cols.append(start_col)
                    current = ""
                tokens.append(op)
                cols.append(op_col)
            else:
                if not current:
                    start_col = i
                current += c
                i += 1
                if c in '\'"' and len(current) == 1:
                    while i < len(line) and line[i] != c:
                        current += line[i]
                        i += 1
                    if i < len(line):
                        current += line[i]
                        i += 1
        if current:
            tokens.append(current)
            cols.append(start_col)
        return tokens, cols

    def read_lines(self, filename):
        try:
            with open(filename, 'r') as f:
                for line_num, line in enumerate(f, 1):
                    line = line.strip()
                    if not line or line.startswith(';'):
                        continue
                    tokens, cols = self.tokenize(line)
                    if not tokens:
                        continue
                    yield line_num, tokens, line, cols
        except FileNotFoundError:
            self.errors.append((None, 0, f"File not found: {filename}", None))

    def _error(self, line_num, col, msg):
        self.errors.append((line_num, col, msg, self.current_raw))

    def _origin_suffix(self, sym):
        origin = sym.get('origin')
        return f" ({origin})" if origin else ""

    def _origin_prefix(self, sym):
        origin = sym.get('origin')
        return f"{origin}: " if origin else ""

    def load_symbols(self):
        # Import the symbol table left by a previous compile, and continue the
        # variable counter after the highest address it used.
        try:
            with open(SYMBOLS_FILE, 'r') as f:
                for line in f:
                    stripped = line.strip()
                    if not stripped or stripped.startswith(';'):
                        continue
                    origin = None
                    semi = stripped.find(';')
                    if semi != -1:
                        origin = stripped[semi + 1:].strip() or None
                        stripped = stripped[:semi].strip()
                        if not stripped:
                            continue
                    tokens = stripped.split()
                    if len(tokens) < 2:
                        continue
                    kind = tokens[0].lower()
                    name = tokens[1]
                    if kind == 'var' and len(tokens) >= 4 and tokens[2] == '=':
                        try:
                            addr = parse_number(tokens[3])
                        except ValueError:
                            continue
                        sym = {'type': 'var', 'addr': addr, 'imported': True}
                        if origin:
                            sym['origin'] = origin
                        self.symbols[name] = sym
                    elif kind == 'const' and len(tokens) >= 4 and tokens[2] == '=':
                        lit = stripped[stripped.index('=') + 1:].strip()
                        sym = {'type': 'const', 'lit': lit, 'imported': True}
                        if origin:
                            sym['origin'] = origin
                        self.symbols[name] = sym
                    elif kind == 'label':
                        sym = {'type': 'label', 'imported': True}
                        if origin:
                            sym['origin'] = origin
                        self.symbols[name] = sym
        except FileNotFoundError:
            pass
        var_addrs = [sym['addr'] for sym in self.symbols.values()
                     if sym['type'] == 'var']
        if var_addrs:
            self.next_var = max(var_addrs) + 1

    def save_symbols(self):
        order = {'var': 0, 'const': 1, 'label': 2}
        with open(SYMBOLS_FILE, 'w') as f:
            f.write("; AXY symbol file - generated by axy compiler, do not edit\n")
            f.write("; Vars, constants and labels shared between .axy files.\n")
            f.write("; Run 'axy -init' to clear this state file.\n")
            f.write("\n")
            for name, sym in sorted(self.symbols.items(),
                                    key=lambda kv: (order.get(kv[1]['type'], 9), kv[0])):
                if sym['type'] == 'reg':
                    continue
                origin = f" ; {sym['origin']}" if sym.get('origin') else ""
                if sym['type'] == 'var':
                    f.write(f"var {name} = &{sym['addr']:02X}{origin}\n")
                elif sym['type'] == 'const':
                    f.write(f"const {name} = {sym['lit']}{origin}\n")
                elif sym['type'] == 'label':
                    f.write(f"label {name}{origin}\n")

    def new_label(self, prefix="L"):
        self.label_counter += 1
        return f".{prefix}{self.label_counter}"

    def resolve_address(self, text):
        hops = 0
        while True:
            try:
                return parse_number(text)
            except ValueError:
                pass
            sym = self.symbols.get(text)
            if sym is None or sym['type'] != 'const':
                return None
            text = sym['lit']
            hops += 1
            if hops > 100:
                return None

    def process_declaration(self, line_num, tokens, cols):
        tokenLower = tokens[0].lower()
        if tokenLower == 'var':
            if len(tokens) != 2:
                self._error(line_num, 0, "'var' needs exactly one name")
                return
            name = tokens[1]
            if name in ('a', 'x', 'y'):
                self._error(line_num, cols[1], f"'{name}' is a reserved register")
                return
            existing = self.symbols.get(name)
            if existing is not None:
                if not existing.get('imported'):
                    self._error(line_num, cols[1], f"'{name}' already defined{self._origin_suffix(existing)}")
                    return
                if existing.get('origin') and existing['origin'] != self.source_file:
                    self._error(line_num, cols[1], f"'{name}' already defined{self._origin_suffix(existing)}")
                    return
                if existing['type'] != 'var':
                    self._error(line_num, cols[1], f"'{name}' already defined as a {existing['type']}{self._origin_suffix(existing)}")
                    return
                addr = existing['addr']
            else:
                if self.next_var is None:
                    self._error(line_num, 0, "No address set for variables - use 'axyvar <address>' or a .axysymbols file")
                    return
                addr = self.next_var
                self.next_var += 1
            self.symbols[name] = {'type': 'var', 'addr': addr, 'origin': self.source_file}
            return

    def _define_const(self, name, lit, line_num, col):
        nameLower = name.lower()
        if nameLower in ('a', 'x', 'y'):
            self._error(line_num, col, f"'{name}' is a reserved register")
            return False
        existing = self.symbols.get(name)
        if existing is not None:
            if not existing.get('imported'):
                self._error(line_num, col, f"'{name}' already defined{self._origin_suffix(existing)}")
                return False
            if existing.get('origin') and existing['origin'] != self.source_file:
                self._error(line_num, col, f"'{name}' already defined{self._origin_suffix(existing)}")
                return False
            if existing['type'] != 'const':
                self._error(line_num, col, f"'{name}' already defined as a {existing['type']}{self._origin_suffix(existing)}")
                return False
            if existing['lit'] != lit:
                self._error(line_num, col, f"'{name}' already defined as '{existing['lit']}'{self._origin_suffix(existing)}")
                return False
        self.symbols[name] = {'type': 'const', 'lit': lit, 'origin': self.source_file}
        return True

    def process_statement(self, line_num, tokens, cols):
        # Labels
        tokenLower = tokens[0].lower()

        if len(tokens) == 1 and tokens[0].startswith('.'):
            self.output.append(tokens[0])
            existing = self.symbols.get(tokens[0])
            if existing is not None:
                if not existing.get('imported'):
                    self._error(line_num, cols[0], f"Label '{tokens[0]}' already defined{self._origin_suffix(existing)}")
                    return
                if existing.get('origin') and existing['origin'] != self.source_file:
                    self._error(line_num, cols[0], f"Label '{tokens[0]}' already defined{self._origin_suffix(existing)}")
                    return
                if existing['type'] != 'label':
                    self._error(line_num, cols[0], f"'{tokens[0]}' already defined as a {existing['type']}{self._origin_suffix(existing)}")
                    return
            self.symbols[tokens[0]] = {'type': 'label', 'origin': self.source_file}
            return
        
        # jmp
        if tokenLower == 'jmp':
            if len(tokens) != 2:
                self._error(line_num, 0, "'jmp label' expected")
                return
            self.output.append(f"jmp {tokens[1]}")
            return
        
        # jsr
        if tokenLower == 'jsr':
            if len(tokens) != 2:
                self._error(line_num, 0, "'jsr label' expected")
                return
            self.output.append(f"jsr {tokens[1]}")
            return
        
        # rts
        if tokenLower == 'rts':
            if len(tokens) != 1:
                self._error(line_num, 0, "'rts' takes no arguments")
                return
            self.output.append("rts")
            return
        
        # pha
        if tokenLower == 'pha':
            if len(tokens) != 1:
                self._error(line_num, 0, "'pha' takes no arguments")
                return
            self.output.append("pha")
            return
        
        # pla
        if tokenLower == 'pla':
            if len(tokens) != 1:
                self._error(line_num, 0, "'pla' takes no arguments")
                return
            self.output.append("pla")
            return
        
        # if statement
        if tokenLower == 'if':
            return self.process_if(line_num, tokens, cols)
        
        # endif
        if tokenLower == 'endif':
            return self.process_endif(line_num, tokens, cols)
        
        # while
        if tokenLower == 'while':
            return self.process_while(line_num, tokens, cols)
        
        # endwhile
        if tokenLower == 'endwhile':
            return self.process_endwhile(line_num, tokens, cols)
        
        # repeat
        if tokenLower == 'repeat':
            return self.process_repeat(line_num, tokens, cols)
        
        # until
        if tokenLower == 'until':
            return self.process_until(line_num, tokens, cols)
        
        # name += 1 or name -= 1
        if len(tokens) == 3 and tokens[1] in ('+=', '-='):
            try:
                parse_number(tokens[2])
            except ValueError:
                self._error(line_num, cols[2], "Invalid number")
                return
            return self.process_incdec(line_num, tokens, cols)
        
        # name = value
        if len(tokens) == 3 and tokens[1] == '=':
            return self.process_assignment(line_num, tokens, cols)
        
        self._error(line_num, 0, "Unrecognized statement")

    def process_if(self, line_num, tokens, cols):
        if len(tokens) != 4:
            self._error(line_num, 0, "Expected 'if reg op value'")
            return
        
        left = tokens[1]
        op = tokens[2]
        val = tokens[3]
        
        if not self._gen_compare(line_num, cols[3], left, val):
            return
        end_label = self.new_label("endif")
        
        self.output.append("{")
        if op == '==':
            self.output.append(f"bne {end_label[1:]}")
        elif op == '!=':
            self.output.append(f"beq {end_label[1:]}")
        else:
            self._error(line_num, cols[2], f"Unsupported operator '{op}'")
            return
        
        self.if_stack.append(end_label)

    def process_endif(self, line_num, tokens, cols):
        if len(tokens) != 1:
            self._error(line_num, 0, "'endif' takes no arguments")
            return
        if not self.if_stack:
            self._error(line_num, 0, "'endif' without matching 'if'")
            return
        self.output.append(self.if_stack.pop())
        self.output.append("}")

    def process_while(self, line_num, tokens, cols):
        if len(tokens) != 4:
            self._error(line_num, 0, "Expected 'while reg op value'")
            return
        
        left = tokens[1]
        op = tokens[2]
        val = tokens[3]
        
        start_label = self.new_label("while")
        end_label = self.new_label("endwhile")
        
        self.output.append("{")
        self.output.append(f"{start_label}")
        if not self._gen_compare(line_num, cols[3], left, val):
            return
        
        if op == '==':
            self.output.append(f"bne {end_label[1:]}")
        elif op == '!=':
            self.output.append(f"beq {end_label[1:]}")
        else:
            self._error(line_num, cols[2], f"Unsupported operator '{op}'")
            return
        
        self.while_stack.append((start_label, end_label))

    def process_endwhile(self, line_num, tokens, cols):
        if len(tokens) != 1:
            self._error(line_num, 0, "'endwhile' takes no arguments")
            return
        if not self.while_stack:
            self._error(line_num, 0, "'endwhile' without matching 'while'")
            return
        start_label, end_label = self.while_stack.pop()
        self.output.append(f"jmp {start_label[1:]}")
        self.output.append(end_label)
        self.output.append("}")

    def process_repeat(self, line_num, tokens, cols):
        if len(tokens) != 1:
            self._error(line_num, 0, "'repeat' takes no arguments")
            return
        
        start_label = self.new_label("repeat")
        end_label = self.new_label("until")
        
        self.output.append("{")
        self.output.append(f"{start_label}")
        
        self.repeat_stack.append((start_label, end_label))

    def process_until(self, line_num, tokens, cols):
        if len(tokens) != 4:
            self._error(line_num, 0, "Expected 'until reg op value'")
            return
        if not self.repeat_stack:
            self._error(line_num, 0, "'until' without matching 'repeat'")
            return
        start_label, end_label = self.repeat_stack.pop()
        
        left = tokens[1]
        op = tokens[2]
        val = tokens[3]
        
        if not self._gen_compare(line_num, cols[3], left, val):
            return
        
        if op == '==':
            self.output.append(f"bne {start_label[1:]}")
        elif op == '!=':
            self.output.append(f"beq {start_label[1:]}")
        else:
            self._error(line_num, cols[2], f"Unsupported operator '{op}'")
            return
        
        self.output.append(end_label)
        self.output.append("}")

    def _gen_compare(self, line_num, col, left, val):
        left_sym = self.symbols.get(left)
        if left_sym is not None and left_sym['type'] == 'reg':
            reg = left
        else:
            if left_sym is not None and left_sym['type'] == 'var':
                self.output.append(f"lda {left}")
            else:
                self.output.append(f"lda #{left}")
            reg = 'a'
        
        try:
            parse_number(val)
            operand = f"#{val}"
        except ValueError:
            if val in self.symbols:
                sym = self.symbols[val]
                if sym['type'] == 'const':
                    operand = f"#{val}"
                elif sym['type'] == 'var':
                    operand = val
                else:
                    self._error(line_num, col, f"Cannot compare '{left}' with register '{val}'")
                    return False
            else:
                if val.startswith('&') or val.startswith('%'):
                    self._error(line_num, col, f"Invalid number '{val}'")
                    return False
                operand = f"#{val}"
        
        if reg == 'a':
            self.output.append(f"cmp {operand}")
        elif reg == 'x':
            self.output.append(f"cpx {operand}")
        elif reg == 'y':
            self.output.append(f"cpy {operand}")
        return True

    def process_incdec(self, line_num, tokens, cols):
        name = tokens[0]
        op = tokens[1]
        amount = parse_number(tokens[2])
        
        if name not in self.symbols:
            self._error(line_num, cols[0], f"Undefined symbol '{name}'")
            return
        
        sym = self.symbols[name]
        
        if sym['type'] == 'reg':
            if name == 'x' and op == '+=' and amount == 1:
                self.output.append("inx")
            elif name == 'x' and op == '-=' and amount == 1:
                self.output.append("dex")
            elif name == 'y' and op == '+=' and amount == 1:
                self.output.append("iny")
            elif name == 'y' and op == '-=' and amount == 1:
                self.output.append("dey")
            else:
                self._error(line_num, cols[2], "Only +/- 1 supported for X/Y")
            return
        
        if sym['type'] == 'const':
            self._error(line_num, cols[0], f"'{name}' is a constant and cannot be changed")
            return
        
        if op == '+=' and amount == 1:
            self.output.append(f"inc {name}")
        elif op == '-=' and amount == 1:
            self.output.append(f"dec {name}")
        else:
            self._error(line_num, cols[2], "Only +=1 and -=1 supported")

    def process_assignment(self, line_num, tokens, cols):
        dest = tokens[0]
        src = tokens[2]
        
        if dest not in self.symbols:
            self._error(line_num, cols[0], f"Undefined symbol '{dest}'")
            return
        
        dest_sym = self.symbols[dest]
        
        if dest_sym['type'] == 'const':
            self._error(line_num, cols[0], f"'{dest}' is a constant and cannot be reassigned")
            return
        
        if src not in self.symbols:
            try:
                parse_number(src)
            except ValueError:
                if src.startswith('&') or src.startswith('%'):
                    self._error(line_num, cols[2], f"Invalid number '{src}'")
                    return
                self._gen_assign_immediate(dest, dest_sym, src)
                return
            self._gen_assign_immediate(dest, dest_sym, src)
            return
        
        src_sym = self.symbols[src]
        if src_sym['type'] == 'const':
            self._gen_assign_immediate(dest, dest_sym, src)
        else:
            self._gen_assign(dest, dest_sym, src, src_sym)

    def _gen_assign_immediate(self, dest, dest_sym, lit):
        if dest_sym['type'] == 'reg':
            if dest == 'a':
                self.output.append(f"lda #{lit}")
            elif dest == 'x':
                self.output.append(f"ldx #{lit}")
            elif dest == 'y':
                self.output.append(f"ldy #{lit}")
        else:
            self.output.append(f"lda #{lit}")
            self.output.append(f"sta {dest}")

    def _gen_assign(self, dest, dest_sym, src, src_sym):
        if dest_sym['type'] == 'reg':
            if dest == 'a':
                if src_sym['type'] == 'reg':
                    if src == 'x':
                        self.output.append("txa")
                    elif src == 'y':
                        self.output.append("tya")
                else:
                    self.output.append(f"lda {src}")
            elif dest == 'x':
                if src_sym['type'] == 'reg':
                    if src == 'a':
                        self.output.append("tax")
                    elif src == 'y':
                        self.output.append("tya")
                        self.output.append("tax")
                else:
                    self.output.append(f"ldx {src}")
            elif dest == 'y':
                if src_sym['type'] == 'reg':
                    if src == 'a':
                        self.output.append("tay")
                    elif src == 'x':
                        self.output.append("txa")
                        self.output.append("tay")
                else:
                    self.output.append(f"ldy {src}")
        
        elif dest_sym['type'] == 'var':
            if src_sym['type'] == 'reg':
                if src == 'a':
                    self.output.append(f"sta {dest}")
                elif src == 'x':
                    self.output.append(f"stx {dest}")
                elif src == 'y':
                    self.output.append(f"sty {dest}")
            else:
                self.output.append(f"lda {src}")
                self.output.append(f"sta {dest}")

    def _pass1(self, filename):
        # Declaration pass: build the symbol table, emit nothing.
        in_asm = False
        for line_num, tokens, raw, cols in self.read_lines(filename):
            self.current_raw = raw
            tokenLower = tokens[0].lower()

            if tokenLower == 'asm':
                in_asm = True
                continue
            if tokenLower == 'endasm':
                in_asm = False
                continue
            if in_asm:
                continue
            if tokenLower == 'var':
                self.process_declaration(line_num, tokens, cols)
            elif tokenLower == 'org':
                if len(tokens) != 2:
                    self._error(line_num, 0, "Expected 'org <address>'")
            elif tokenLower == 'axyvar':
                if len(tokens) != 2:
                    self._error(line_num, 0, "Expected 'axyvar <address>'")
                    continue
                addr = self.resolve_address(tokens[1])
                if addr is None:
                    self._error(line_num, cols[1], f"Invalid address '{tokens[1]}'")
                    continue
                self.next_var = addr
            elif (len(tokens) == 3 and tokens[1] == '='
                    and not tokens[0].startswith('.')
                    and tokenLower not in KEYWORDS):
                existing = self.symbols.get(tokens[0])
                if (existing is None
                        or (existing.get('imported') and existing['type'] == 'const')):
                    if self._define_const(tokens[0], tokens[2], line_num, cols[0]):
                        self.const_def_lines.add(line_num)
        return not self.errors

    def _pass2(self, filename, target):
        # Statement pass: stream assembly out, line by line.
        target.write(f"; Generated by axy compiler {timestamp()}\n")
        target.write("\n")

        in_asm = False
        with open(filename, 'r') as f:
            for line_num, raw_line in enumerate(f, 1):
                if in_asm:
                    stripped = raw_line.strip()
                    tokens, cols = self.tokenize(stripped)
                    if tokens and tokens[0].lower() == 'endasm':
                        in_asm = False
                        continue
                    target.write(raw_line)
                    continue

                stripped = raw_line.strip()
                leading_ws = raw_line[:len(raw_line) - len(raw_line.lstrip())]
                if not stripped:
                    target.write(raw_line)
                    continue
                if stripped.startswith(';'):
                    target.write(raw_line)
                    continue
                self.current_raw = stripped
                comment = ''
                semi = stripped.find(';')
                if semi != -1:
                    comment = stripped[semi:]
                    stripped = stripped[:semi].rstrip()
                tokens, cols = self.tokenize(stripped)
                if not tokens:
                    continue
                tokenLower = tokens[0].lower()
                if tokenLower == 'asm':
                    if len(tokens) != 1:
                        self._error(line_num, 0, "'asm' takes no arguments")
                        return False
                    in_asm = True
                    continue
                if tokenLower == 'endasm':
                    self._error(line_num, 0, "'endasm' without matching 'asm'")
                    return False
                if tokenLower == 'var':
                    sym = self.symbols[tokens[1]]
                    target.write(f"{leading_ws}{tokens[1]} = &{sym['addr']:02X}{comment}\n")
                    continue
                if tokenLower == 'org':
                    target.write(f"{leading_ws}{tokens[0]} {tokens[1]}{comment}\n")
                    continue
                if line_num in self.const_def_lines:
                    target.write(f"{leading_ws}{tokens[0]} = {tokens[2]}{comment}\n")
                    continue
                if tokenLower not in ('var', 'org', 'axyvar'):
                    self.process_statement(line_num, tokens, cols)
                    if self.errors:
                        return False
                    if comment:
                        for i, line in enumerate(self.output):
                            s = line.strip()
                            if s not in ('{', '}') and not s.startswith('.'):
                                self.output[i] = f"{line}{comment}"
                                break
                        else:
                            self.output[0] = f"{self.output[0]}{comment}"
                    for line in self.output:
                        target.write(f"{leading_ws}{line}\n")
                    self.output.clear()

        if in_asm:
            self._error(None, 0, "Missing 'endasm'")
            return False

        if self.if_stack:
            self._error(None, 0, "Missing 'endif'")
            return False

        if self.while_stack:
            self._error(None, 0, "Missing 'endwhile'")
            return False

        if self.repeat_stack:
            self._error(None, 0, "Missing 'until'")
            return False

        return True

    def translate(self, filename, outfile):
        self.source_file = os.path.basename(filename)
        self.if_stack = []
        self.while_stack = []
        self.repeat_stack = []

        if not self._pass1(filename):
            return False

        target = open(outfile, 'w') if outfile else sys.stdout
        try:
            return self._pass2(filename, target)
        finally:
            if outfile:
                target.close()

    def report(self, stream=sys.stdout, include_imported=False):
        if include_imported:
            items = self.symbols
            prefix = self._origin_prefix
        else:
            items = {name: sym for name, sym in self.symbols.items()
                     if not sym.get('imported')}
            prefix = (lambda sym: "")

        print(f"  Variables:", file=stream)
        for name, sym in items.items():
            if sym['type'] == 'var':
                print(f"    {prefix(sym)}{name} = ${sym['addr']:02X}", file=stream)
        print(f"", file=stream)

        print(f"  Constants:", file=stream)
        for name, sym in items.items():
            if sym['type'] == 'const':
                print(f"    {prefix(sym)}{name} = {sym['lit']}", file=stream)
        print(f"", file=stream)

        print(f"  Labels:", file=stream)
        for name, sym in items.items():
            if sym['type'] == 'label':
                print(f"    {prefix(sym)}{name}", file=stream)

    def format_error(self, line_num, col, msg, raw):
        parts = []
        if raw is not None:
            parts.append(f"  {raw}")
            parts.append(f"  {' ' * col}^")
        parts.append(f"  Line {line_num}: {msg}")
        return "\n".join(parts)

def main():
    verbose = False
    init = False
    args = []
    for arg in sys.argv[1:]:
        if arg == '-v':
            verbose = True
        elif arg == '-init':
            init = True
        else:
            args.append(arg)

    if init:
        try:
            os.remove(SYMBOLS_FILE)
        except FileNotFoundError:
            pass

    if not args:
        if verbose:
            compiler = AXYCompiler()
            compiler.load_symbols()
            if init:
                compiler.report()
            else:
                compiler.report(include_imported=True)
            return
        if init:
            return
        print("axy compiler")
        print("usage: axy [-v] [-init] input.axy [output.asm]")
        print("if no output file is given, the generated assembly is written to stdout.")
        print()
        print("  -init               - remove the .axysymbols state file")
        print("  -v                  - print the symbol report after compiling")
        print()
        print("features: (see README.md for complete details)")
        print("  org <address>       - Set program start address")
        print("  axyvar <address>    - Set variable allocation start address")
        print("  var name            - Declare variable")
        print("  name = value        - Defines a constant (if name not already defined)")
        print("  name = value        - Assignment to variable if variable name already defined")
        print("  name += 1           - Increment")
        print("  name -= 1           - Decrement")
        print("  .name               - Define label")
        print("  jmp label           - Unconditional jump")
        print("  jsr label           - Jump to subroutine")
        print("  rts                 - Return from subroutine")
        print("  if reg == value     - Conditional branch")
        print("  endif               - End of if block")
        print("  if name != name     - Conditional branch")
        print("  endif               - End of if block")
        print("  while reg != value  - While loop")
        print("  endwhile            - End of while loop")
        print("  repeat              - Repeat loop (body runs at least once)")
        print("  until reg == value  - Loop back while false, exit when true")
        print("  asm                 - Raw assembler passthrough")
        print("  endasm              - Back to AXY mode")
        sys.exit(1)
    
    infile = args[0]
    outfile = args[1] if len(args) > 1 else None
    
    if outfile is not None and os.path.realpath(infile) == os.path.realpath(outfile):
        print(f"✗ Input and output are the same file: {infile}")
        sys.exit(1)
    
    compiler = AXYCompiler()
    compiler.load_symbols()

    if compiler.translate(infile, outfile):
        compiler.save_symbols()
        if verbose:
            if outfile is None:
                compiler.report(sys.stderr)
            else:
                compiler.report()
    else:
        stream = sys.stderr if outfile is None else sys.stdout
        for line_num, col, msg, raw in compiler.errors:
            if line_num is None:
                print(f"  {msg}", file=stream)
            else:
                print(compiler.format_error(line_num, col, msg, raw), file=stream)
        sys.exit(1)

if __name__ == "__main__":
    main()
